# Copy to backend/.env and fill in. Never commit .env.
APP_ENV=local
LOG_LEVEL=INFO
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# SQLite for local dev; docker-compose overrides with Postgres
DATABASE_URL=sqlite+aiosqlite:///./pactpay.db

# PayPal sandbox app credentials (developer.paypal.com -> Apps & Credentials)
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_CURRENCY=USD
PLATFORM_FEE_PERCENT=5.0

# AI
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
JUDGE_CONFIDENCE_THRESHOLD=0.8
