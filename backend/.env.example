# Copy to backend/.env and fill in. Never commit .env.
APP_ENV=local
LOG_LEVEL=INFO
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# SQLite for local dev; docker-compose overrides with Postgres
DATABASE_URL=sqlite+aiosqlite:///./pactpay.db

# PayPal sandbox app credentials (developer.paypal.com -> Apps & Credentials)
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# true only to accept webhook-simulator events locally (they can't be signature-verified)
PAYPAL_WEBHOOK_SKIP_VERIFY=false
PAYPAL_CURRENCY=USD
PLATFORM_FEE_PERCENT=5.0

# AI
OPENAI_API_KEY=
LLM_MODEL=gpt-4o
JUDGE_CONFIDENCE_THRESHOLD=0.8

# Auth / demo
SECRET_KEY=change-me-in-production
DEMO_MODE=true
DEMO_FREELANCER_PAYPAL_EMAIL=
AUTO_APPROVE_HOURS=48

# SSRF guard: keep false in production; true only for local demo sites on 127.0.0.1
ALLOW_PRIVATE_URLS=false
